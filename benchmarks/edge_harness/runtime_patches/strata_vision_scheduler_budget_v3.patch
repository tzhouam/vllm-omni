+// Runtime-private allocation guard; does not split or rewrite the graph.
+extern "C" bool omni_ggml_sched_set_buffer_limits(ggml_backend_sched_t sched, const size_t * limits, int count) {
+    if (!sched || !limits || count != sched->n_backends || sched->is_alloc) return false;
+    for (int i = 0; i < count; ++i) sched->omni_buffer_limits[i] = limits[i];
+    sched->omni_limits_set = true;
+    return true;
+}
+static bool omni_ggml_sched_check_buffer_limits(ggml_backend_sched_t sched) {
+    if (!sched->omni_limits_set) return true;
+    std::vector<size_t> retained(sched->n_backends), planned(sched->n_backends);
+    for (int i = 0; i < sched->n_backends; ++i)
+        retained[i] = ggml_gallocr_get_buffer_size(sched->galloc, i);
+    ggml_gallocr_reserve_n_size(sched->galloc, &sched->graph,
+        sched->node_backend_ids, sched->leaf_backend_ids, planned.data());
+    for (int i = 0; i < sched->n_backends; ++i) {
+        if (std::max(retained[i], planned[i]) > sched->omni_buffer_limits[i]) {
+            GGML_LOG_ERROR("vision buffer budget refused backend=%s planned=%zu retained=%zu limit=%zu\n",
+                ggml_backend_name(sched->backends[i]), planned[i], retained[i], sched->omni_buffer_limits[i]);
+            return false;
+        }
+    }
+    return true;
+}
