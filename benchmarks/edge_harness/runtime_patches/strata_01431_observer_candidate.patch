+// Incremental Omni native observer, opt-in and partial coverage. No CUDA API calls.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <limits>
+
+namespace strata::omni_exec {
+
+// C++17 inline objects give all linked translation units one observer. There is
+// no function-local initialization or lock/allocation on the CPU callback path.
+inline const bool enabled = [] {
+    const char* value = std::getenv("STRATA_OMNI_EXEC_OBSERVER");
+#if defined(STRATA_USE_HIP) || defined(STRATA_HIP_GFX906)
+    (void) value;
+    return false;  // This patch makes CUDA claims only; HIP aliases are unreviewed.
+#else
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+#endif
+}();
+
+constexpr unsigned phase_count = 3;  // outside/loading, request prefill, request decode
+constexpr unsigned cpu_kind_count = 4;  // full, split, split_multi, split_multi_native
+constexpr unsigned cpu_phase_count = 7;  // mode 0 unused; existing row phases 1..6
+constexpr unsigned cuda_kind_count = 2;  // session_run_token, Verifier::run
+constexpr unsigned root_capacity = 16;
+constexpr std::size_t frame_bytes = 32768;
+enum Issue : uint64_t {
+    counter_overflow = 1, invalid_geometry = 2, stale_scope = 4,
+    invalid_boundary = 8, unresolved_work = 16, registry_exhausted = 32,
+    missing_root = 64, duplicate_root = 128, allocation_api_error = 256,
+    free_api_error = 512, graph_launch_error = 1024, graph_fence_error = 2048,
+    report_overflow = 4096, clock_unavailable = 8192,
+};
+
+struct CpuCounters {
+    std::atomic<uint64_t> submitted{0}, completed{0}, jobs_submitted{0}, jobs_completed{0};
+    std::atomic<uint64_t> entries_submitted{0}, entries_completed{0};
+};
+struct PhaseCounters {
+    std::atomic<uint64_t> submitted{0}, completed{0}, tasks_submitted{0}, tasks_completed{0};
+};
+struct CudaCounters {
+    std::atomic<uint64_t> attempts{0}, submitted{0}, completed{0}, launch_errors{0}, fence_errors{0};
+    std::atomic<int> last_launch_status{-1}, last_fence_status{-1};
+};
+struct Root { const void* owner = nullptr; uint64_t bytes = 0, serial = 0; };
+struct State {
+    // One atomic key is an immutable (native sequence, phase) capture. Counters
+    // are lifetime cumulative; snapshots are independent atomic loads, not a
+    // coherent global transaction. Never impose cross-counter equalities.
+    std::atomic<uint64_t> scope_key{0}, issues{0}, cpu_inflight{0}, cuda_inflight{0};
+    CpuCounters cpu[phase_count][cpu_kind_count];
+    PhaseCounters cpu_phase[phase_count][cpu_phase_count];
+    CudaCounters cuda[phase_count][cuda_kind_count];
+    std::atomic_flag roots_lock = ATOMIC_FLAG_INIT;
+    Root roots[root_capacity];
+    uint64_t next_root_serial = 0;  // accessed only under roots_lock
+    std::atomic<uint64_t> alloc_attempts{0}, alloc_success{0}, alloc_errors{0};
+    std::atomic<uint64_t> free_attempts{0}, free_success{0}, free_errors{0};
+    std::atomic<int> last_alloc_status{-1}, last_free_status{-1};
+    std::atomic<uint64_t> tracked_live{0}, lifetime_peak{0}, request_peak{0};
+    std::atomic<uint64_t> untracked_cache_families{0};  // 1 segmented, 2 VMM
+    unsigned next_snapshot = 0;  // only native request owner writes/emits
+};
+inline State state;
+static_assert(sizeof(State) <= 16384, "fixed observer state grew beyond declared bound");
+static_assert(std::atomic<uint64_t>::is_always_lock_free, "callback counters must be lock-free");
+static_assert(std::atomic<int>::is_always_lock_free, "callback status counters must be lock-free");
+
+inline void issue(uint64_t value) { state.issues.fetch_or(value, std::memory_order_relaxed); }
+inline uint64_t get(const std::atomic<uint64_t>& value) { return value.load(std::memory_order_relaxed); }
+inline void add(std::atomic<uint64_t>& value, uint64_t delta) {
+    auto previous = value.load(std::memory_order_relaxed);
+    for (;;) {
+        const bool overflow = delta > (std::numeric_limits<uint64_t>::max)() - previous;
+        const auto next = overflow ? (std::numeric_limits<uint64_t>::max)() : previous + delta;
+        if (value.compare_exchange_weak(previous, next, std::memory_order_relaxed)) {
+            if (overflow) issue(counter_overflow);
+            return;
+        }
+    }
+}
+inline void peak(std::atomic<uint64_t>& value, uint64_t candidate) {
+    auto previous = get(value);
+    while (previous < candidate && !value.compare_exchange_weak(previous, candidate, std::memory_order_relaxed)) {}
+}
+inline unsigned phase(uint64_t key) { return (unsigned) (key & 3); }
+inline uint64_t scope() { return state.scope_key.load(std::memory_order_acquire); }
+inline void retire_work(std::atomic<uint64_t>& inflight, uint64_t key) {
+    if (scope() != key) issue(stale_scope);
+    auto previous = get(inflight);
+    while (previous != 0 && !inflight.compare_exchange_weak(previous, previous - 1, std::memory_order_relaxed)) {}
+    if (previous == 0) issue(unresolved_work);
+}
+
+struct Ticket {
+    uint64_t key = 0, jobs = 0, entries = 0;
+    unsigned kind = 0;
+    bool active = false;
+};
+template <class Jobs> inline uint64_t entries(const Jobs* jobs, int n) {
+    if (!enabled) return 0;
+    uint64_t total = 0;
+    for (int i = 0; i < n; ++i) {
+        if (jobs[i].nt < 0 || (uint64_t) jobs[i].nt > (std::numeric_limits<uint64_t>::max)() - total) {
+            issue(invalid_geometry); return 0;
+        }
+        total += (uint64_t) jobs[i].nt;
+    }
+    return total;
+}
+inline Ticket cpu_begin(unsigned kind, uint64_t jobs, uint64_t entries_count) {
+    if (!enabled) return {};
+    const auto key = scope();
+    if (kind >= cpu_kind_count || phase(key) >= phase_count) { issue(invalid_geometry); return {}; }
+    auto& c = state.cpu[phase(key)][kind];
+    add(c.submitted, 1); add(c.jobs_submitted, jobs); add(c.entries_submitted, entries_count);
+    add(state.cpu_inflight, 1);
+    return {key, jobs, entries_count, kind, true};
+}
+inline void cpu_complete(const Ticket& t) {
+    if (!t.active) return;
+    auto& c = state.cpu[phase(t.key)][t.kind];
+    add(c.completed, 1); add(c.jobs_completed, t.jobs); add(c.entries_completed, t.entries);
+    retire_work(state.cpu_inflight, t.key);
+}
+inline Ticket cpu_phase_begin(int mode, int tasks) {
+    if (!enabled) return {};
+    const auto key = scope();
+    if (mode < 1 || mode > 6 || tasks < 0 || phase(key) >= phase_count) { issue(invalid_geometry); return {}; }
+    auto& c = state.cpu_phase[phase(key)][mode];
+    add(c.submitted, 1); add(c.tasks_submitted, (uint64_t) tasks); add(state.cpu_inflight, 1);
+    return {key, (uint64_t) tasks, 0, (unsigned) mode, true};
+}
+inline void cpu_phase_complete(const Ticket& t) {
+    if (!t.active) return;
+    auto& c = state.cpu_phase[phase(t.key)][t.kind];
+    add(c.completed, 1); add(c.tasks_completed, t.jobs);
+    retire_work(state.cpu_inflight, t.key);
+}
+inline Ticket cuda_prepare(unsigned kind) {
+    if (!enabled) return {};
+    const auto key = scope();
+    if (kind >= cuda_kind_count || phase(key) >= phase_count) { issue(invalid_geometry); return {}; }
+    return {key, 0, 0, kind, true};
+}
+inline void cuda_launch_result(Ticket& t, int status, bool successful) {
+    if (!t.active) return;
+    auto& c = state.cuda[phase(t.key)][t.kind];
+    add(c.attempts, 1); c.last_launch_status.store(status, std::memory_order_relaxed);
+    if (successful) { add(c.submitted, 1); add(state.cuda_inflight, 1); }
+    else { add(c.launch_errors, 1); issue(graph_launch_error); t.active = false; }
+}
+inline void cuda_fence_result(const Ticket& t, int status, bool successful) {
+    if (!t.active) return;
+    auto& c = state.cuda[phase(t.key)][t.kind];
+    c.last_fence_status.store(status, std::memory_order_relaxed);
+    if (successful) { add(c.completed, 1); retire_work(state.cuda_inflight, t.key); }
+    else { add(c.fence_errors, 1); issue(graph_fence_error); }  // completion is still unknown
+}
+
+// Only allocation/free hooks and request-peak reset use this fixed registry.
+// No observer lock spans a CUDA API, pool wait, or host callback. Private owner
+// pointers never leave this object. Failed frees retain their live allocation.
+struct RootsGuard {
+    RootsGuard() { while (state.roots_lock.test_and_set(std::memory_order_acquire)) {} }
+    ~RootsGuard() { state.roots_lock.clear(std::memory_order_release); }
+};
+inline void untracked_cache_family(uint64_t bit) {
+    if (enabled) state.untracked_cache_families.fetch_or(bit, std::memory_order_relaxed);
+}
+inline void cache_alloc_result(const void* owner, uint64_t bytes, int status, bool successful) {
+    if (!enabled) return;
+    add(state.alloc_attempts, 1); state.last_alloc_status.store(status, std::memory_order_relaxed);
+    if (!successful) { add(state.alloc_errors, 1); issue(allocation_api_error); return; }
+    add(state.alloc_success, 1);
+    RootsGuard lock;
+    Root* empty = nullptr;
+    for (auto& r : state.roots) {
+        if (r.owner == owner) issue(duplicate_root);  // e.g. a previous failed free
+        if (r.owner == nullptr && empty == nullptr) empty = &r;
+    }
+    if (empty == nullptr || owner == nullptr || bytes == 0) { issue(registry_exhausted); return; }
+    if (state.next_root_serial == (std::numeric_limits<uint64_t>::max)()) { issue(counter_overflow); return; }
+    *empty = {owner, bytes, ++state.next_root_serial};
+    add(state.tracked_live, bytes);
+    peak(state.lifetime_peak, get(state.tracked_live));
+    if (phase(scope()) != 0) peak(state.request_peak, get(state.tracked_live));
+}
+inline void cache_free_result(const void* owner, int status, bool successful) {
+    if (!enabled) return;
+    add(state.free_attempts, 1); state.last_free_status.store(status, std::memory_order_relaxed);
+    if (!successful) { add(state.free_errors, 1); issue(free_api_error); return; }
+    add(state.free_success, 1);
+    RootsGuard lock;
+    Root* found = nullptr;
+    for (auto& r : state.roots)
+        if (r.owner == owner && (found == nullptr || r.serial > found->serial)) found = &r;
+    if (found == nullptr) { issue(missing_root); return; }
+    const auto live = get(state.tracked_live);
+    if (found->bytes > live) { issue(counter_overflow); return; }
+    state.tracked_live.store(live - found->bytes, std::memory_order_relaxed);
+    *found = {};
+}
+inline void request_begin(uint64_t seq) {
+    if (!enabled) return;
+    const auto previous = scope();
+    if (seq == 0 || seq > ((std::numeric_limits<uint64_t>::max)() >> 2) || seq <= (previous >> 2)) {
+        issue(invalid_boundary); return;
+    }
+    if (phase(previous) != 0) issue(invalid_boundary);
+    if (get(state.cpu_inflight) != 0 || get(state.cuda_inflight) != 0) issue(unresolved_work);
+    RootsGuard lock;
+    state.request_peak.store(get(state.tracked_live), std::memory_order_relaxed);
+    state.scope_key.store((seq << 2) | 1, std::memory_order_release);
+    state.next_snapshot = 0;
+}
+inline void decode_begin(uint64_t seq) {
+    if (!enabled) return;
+    if (scope() != ((seq << 2) | 1)) { issue(invalid_boundary); return; }
+    if (get(state.cpu_inflight) != 0 || get(state.cuda_inflight) != 0) issue(unresolved_work);
+    state.scope_key.store((seq << 2) | 2, std::memory_order_release);
+}
+inline void request_retire(uint64_t seq) {
+    if (!enabled) return;
+    if ((scope() >> 2) != seq) { issue(invalid_boundary); return; }
+    state.scope_key.store(seq << 2, std::memory_order_release);
+}
+
+struct Frame {
+    char data[frame_bytes]{};
+    std::size_t used = 0;
+    bool good = true;
+    template <class... Args> void put(const char* format, Args... args) {
+        if (!good) return;
+        const int n = std::snprintf(data + used, sizeof(data) - used, format, args...);
+        if (n < 0 || (std::size_t) n >= sizeof(data) - used) { good = false; issue(report_overflow); return; }
+        used += (std::size_t) n;
+    }
+    void number(uint64_t value) { put("%llu", (unsigned long long) value); }
+};
+inline void optional_status(Frame& f, int status) {
+    if (status == -1) f.put("null"); else f.put("%d", status);
+}
+inline const char* phase_name(unsigned p) { return p == 1 ? "prefill" : p == 2 ? "decode" : "outside_request"; }
+inline const char* cpu_name(unsigned k) {
+    constexpr const char* names[] = {"full", "split", "split_multi", "split_multi_native"}; return names[k];
+}
+inline void snapshot(const char* boundary, uint64_t seq, bool cancelled, uint64_t ticks, uint64_t hz) {
+    if (!enabled) return;
+    // Exact internal labels only. Reject null/short/unknown inputs before
+    // indexing or formatting them; the original native callers use literals.
+    if (boundary == nullptr) { issue(invalid_boundary); return; }
+    const bool start = std::strcmp(boundary, "request_start") == 0;
+    const bool middle = std::strcmp(boundary, "prefill_end_decode_start") == 0;
+    const bool end = std::strcmp(boundary, "request_end") == 0;
+    if (!start && !middle && !end) { issue(invalid_boundary); return; }
+    const unsigned index = start ? 0 : end ? 2 : 1;
+    if ((scope() >> 2) != seq || index != state.next_snapshot || index > 2) { issue(invalid_boundary); return; }
+    ++state.next_snapshot;
+    if (ticks == 0 || hz == 0) issue(clock_unavailable);
+    if (end && (get(state.cpu_inflight) != 0 || get(state.cuda_inflight) != 0)) issue(unresolved_work);
+    Frame f;
+    f.put("OMNI_EXEC_V1 {\"schema\":\"strata-omni-exec-v1\",\"native_request_seq\":"); f.number(seq);
+    f.put(",\"snapshot_seq\":%u,\"phase\":\"%s\",\"clock\":{\"source\":\"Windows_QPC\",\"ticks\":", index, boundary);
+    if (ticks == 0 || hz == 0) f.put("null,\"frequency_hz\":null}");
+    else { f.number(ticks); f.put(",\"frequency_hz\":"); f.number(hz); f.put("}"); }
+    f.put(",\"counter_scope\":\"process_lifetime_cumulative_phase_at_submission\","
+          "\"snapshot_coherent\":false,\"scope_status\":\"partial_coverage\",\"request_terminal\":");
+    f.put(end ? (cancelled ? "\"cancelled\"" : "\"completed\"") : "null");
+    f.put(",\"boundary_complete\":%s,\"issues\":", end && !cancelled && get(state.issues) == 0 ? "true" : "false");
+    f.number(get(state.issues));
+    f.put(",\"observer\":{\"state_bytes\":%llu,\"frame_buffer_bytes\":%llu,\"frame_state_bytes\":%llu,"
+          "\"ticket_bytes\":%llu,\"concurrent_ticket_count_verified\":false,\"root_registry_capacity\":%u,"
+          "\"overhead_scope\":\"fixed_Cpp_state_and_one_owner_frame_plus_per_call_stack_ticket_excludes_CRT_stdio\"},"
+          "\"inflight\":{\"cpu_methods_and_phases\":", (unsigned long long) sizeof(State),
+          (unsigned long long) frame_bytes, (unsigned long long) sizeof(Frame),
+          (unsigned long long) sizeof(Ticket), root_capacity);
+    f.number(get(state.cpu_inflight)); f.put(",\"cuda_replays\":"); f.number(get(state.cuda_inflight));
+    f.put("},\"counters\":{\"cpu\":[");
+    bool comma = false;
+    for (unsigned p = 0; p < phase_count; ++p) for (unsigned k = 0; k < cpu_kind_count; ++k) {
+        auto& c = state.cpu[p][k];
+        if (comma) f.put(","); comma = true;
+        f.put("{\"phase\":\"%s\",\"family\":\"%s\",\"unit\":\"CPU_expert_method\",\"submitted\":", phase_name(p), cpu_name(k));
+        f.number(get(c.submitted)); f.put(",\"completed\":"); f.number(get(c.completed));
+        f.put(",\"unique_jobs_submitted\":"); f.number(get(c.jobs_submitted));
+        f.put(",\"unique_jobs_completed\":"); f.number(get(c.jobs_completed));
+        f.put(",\"token_expert_entries_submitted\":"); f.number(get(c.entries_submitted));
+        f.put(",\"token_expert_entries_completed\":"); f.number(get(c.entries_completed)); f.put("}");
+    }
+    f.put("],\"cpu_phase\":["); comma = false;
+    for (unsigned p = 0; p < phase_count; ++p) for (unsigned k = 1; k < cpu_phase_count; ++k) {
+        auto& c = state.cpu_phase[p][k];
