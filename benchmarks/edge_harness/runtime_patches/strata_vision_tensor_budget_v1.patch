+static void omni_vision_check_graph_budget(clip_ctx & ctx, ggml_cgraph * graph) {
+    if (!ctx.omni_budget_enabled) return;
+    std::vector<size_t> retained(ctx.backend_ptrs.size()), planned(ctx.backend_ptrs.size());
+    for (size_t i = 0; i < retained.size(); ++i)
+        retained[i] = ggml_backend_sched_get_buffer_size(ctx.sched.get(), ctx.backend_ptrs[i]);
+    // Measurement can release undersized buffers, but does not allocate device buffers.
+    ggml_backend_sched_reserve_size(ctx.sched.get(), graph, planned.data());
+    size_t gpu = ctx.omni_gpu_weights, host = ctx.omni_host_weights;
+    for (size_t i = 0; i < planned.size(); ++i) {
+        const size_t bytes = std::max(retained[i], planned[i]);
+        if (ggml_backend_buft_is_host(ctx.backend_buft[i])) host = omni_vision_budget_add(host, bytes);
+        else gpu = omni_vision_budget_add(gpu, bytes);
+    }
+    omni_vision_budget_require(gpu, host, ctx.omni_gpu_limit, ctx.omni_host_limit);
+    std::fprintf(stdout, "OMNI_VISION_MEMORY_V1 {\"schema\":\"strata-vision-memory-v1\","
+        "\"scope\":\"explicit_ggml_tensor_buffers\",\"gpu_bytes\":%zu,\"host_bytes\":%zu,"
+        "\"gpu_limit\":%zu,\"host_limit\":%zu,\"phase\":\"before_graph_allocation\"}\n",
+        gpu, host, ctx.omni_gpu_limit, ctx.omni_host_limit);
+    std::fflush(stdout);
+    if (!ggml_backend_sched_reserve(ctx.sched.get(), graph))
+        throw std::runtime_error("vision admitted graph reserve failed");
+    ggml_backend_sched_reset(ctx.sched.get());
+}
 
