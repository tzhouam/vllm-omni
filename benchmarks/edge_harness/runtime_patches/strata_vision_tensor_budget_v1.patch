+// These limits cover explicit ggml tensors only. The caller reserves CUDA
+// context/library overhead and host preprocessing separately in its lease.
+static size_t omni_vision_budget_env(const char * name) {
+    const char * value = std::getenv(name);
+    if (!value || !*value) throw std::runtime_error("missing vision tensor budget");
+    size_t result = 0;
+    for (const char * p = value; *p; ++p) {
+        if (*p < '0' || *p > '9' || result > (std::numeric_limits<size_t>::max() - (*p - '0')) / 10)
+            throw std::runtime_error("invalid vision tensor budget");
+        result = result * 10 + (*p - '0');
+    }
+    return result;
+}
+static size_t omni_vision_budget_add(size_t a, size_t b) {
+    if (b > std::numeric_limits<size_t>::max() - a)
+        throw std::runtime_error("vision tensor accounting overflow");
+    return a + b;
+}
+static void omni_vision_budget_require(size_t gpu, size_t host, size_t gpu_limit, size_t host_limit) {
+    if (gpu > gpu_limit || host > host_limit)
+        throw std::runtime_error("vision explicit tensor budget exceeded before allocation");
+}
